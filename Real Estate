        <div class="property-card">
            <img src="https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?auto=format&fit=crop&w=700&q=80"
                 alt="Premium modern home">

            <div class="property-info">
                <span class="tag">For Sale</span>
                <h3>Premium Modern Home</h3>
                <p class="location">📍 Kukatpally, Hyderabad</p>
                <p class="price">₹95 Lakhs</p>
                <div class="amenities">
                    🛏 Bedrooms: 3<br>
                    🛁 Bathrooms: 3<br>
