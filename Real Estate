
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DreamHomes - Real Estate</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f4f7f9;
            color: #333;
        }

        header {
            background-color: #173b57;
            color: white;
            padding: 22px;
            text-align: center;
        }

        header h1 {
            margin-bottom: 8px;
        }

        nav {
            background-color: #23658a;
            padding: 15px;
            text-align: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 12px;
            font-weight: bold;
        }

        .hero {
            background: linear-gradient(120deg, #cce7f5, #e7f3e8);
            text-align: center;
            padding: 45px 20px;
        }

        .hero h2 {
            color: #173b57;
            font-size: 32px;
            margin-bottom: 12px;
        }

        .hero p {
            margin-bottom: 20px;
        }

        .search-box {
            background-color: white;
            max-width: 950px;
            margin: auto;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 3px 10px #ccc;
        }

        .search-box form {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
        }

        input, select {
            width: 100%;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        button, .btn {
            background-color: #23658a;
            color: white;
            border: none;
            padding: 12px 18px;
            border-radius: 5px;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
        }

        button:hover, .btn:hover {
            background-color: #173b57;
        }

        .section-title {
            text-align: center;
            margin: 30px 0 20px;
            color: #173b57;
        }

        .properties {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 22px;
            max-width: 1200px;
            margin: auto;
            padding: 20px;
        }

        .property-card {
            background-color: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 3px 10px #ddd;
        }

        .property-card img {
            width: 100%;
            height: 210px;
            object-fit: cover;
        }

        .property-info {
            padding: 18px;
        }

        .property-info h3 {
            color: #173b57;
            margin-bottom: 10px;
        }

        .location {
            color: #666;
            margin-bottom: 10px;
        }

        .price {
            color: #198754;
            font-size: 22px;
            font-weight: bold;
            margin: 12px 0;
        }

        .tag {
            display: inline-block;
            background-color: #d9f2e4;
            color: #17663c;
            padding: 6px 10px;
            border-radius: 4px;
            margin-bottom: 10px;
            font-size: 13px;
        }

        .amenities {
            line-height: 1.8;
            margin-bottom: 15px;
            font-size: 14px;
        }

        .comparison {
            padding: 20px;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background-color: white;
        }

        th, td {
            border: 1px solid #ccc;
            padding: 13px;
            text-align: center;
        }

        th {
            background-color: #173b57;
            color: white;
        }

        tr:nth-child(even) {
            background-color: #eaf2f8;
        }

        .contact {
            background-color: #dcebf3;
            text-align: center;
            padding: 30px 20px;
            line-height: 2;
        }

        footer {
            background-color: #173b57;
            color: white;
            text-align: center;
            padding: 20px;
        }

        @media (max-width: 850px) {
            .properties {
                grid-template-columns: repeat(2, 1fr);
            }

            .search-box form {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 550px) {
            nav a {
                display: inline-block;
                margin: 8px;
            }

            .properties,
            .search-box form {
                grid-template-columns: 1fr;
            }

            .hero h2 {
                font-size: 26px;
            }
        }
    </style>
</head>

<body>

    <header>
        <h1>🏡 DreamHomes</h1>
        <p>Find Your Perfect Place to Live</p>
    </header>

    <nav>
        <a href="#home">Home</a>
        <a href="#properties">Properties</a>
        <a href="#comparison">Compare</a>
        <a href="#contact">Contact</a>
    </nav>

    <section class="hero" id="home">
        <h2>Discover Your Dream Property</h2>
        <p>Explore houses, apartments, and rental properties.</p>

        <div class="search-box">
            <form action="#properties" method="get">

                <input type="text" name="location"
                       placeholder="Enter location">

                <select name="type">
                    <option value="">Property Type</option>
                    <option>House</option>
                    <option>Apartment</option>
                    <option>Villa</option>
                    <option>Rental</option>
                </select>

                <select name="budget">
                    <option value="">Select Budget</option>
                    <option>Below ₹50 Lakhs</option>
                    <option>₹50 Lakhs - ₹1 Crore</option>
                    <option>Above ₹1 Crore</option>
                </select>

                <button type="submit">Search Properties</button>

            </form>
        </div>
    </section>

